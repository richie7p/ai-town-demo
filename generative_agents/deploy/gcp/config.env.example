# 複製成 config.env 再修改（config.env 不會被 git 追蹤）。這裡不放任何金鑰：
# API Key 由 setup.sh 存進 Secret Manager。
PROJECT_ID=your-project-id
REGION=asia-east1                 # 台灣
ZONE=asia-east1-b
BUCKET=your-project-id-ga-runs    # setup.sh 會自動建立
REPO=generative-agents            # Artifact Registry 映像庫
VM_NAME=ga-sim
MACHINE_TYPE=e2-standard-4        # 4 vCPU、16 GB RAM
DISK_SIZE_GB=50

# ---- 模擬 ----
SIM=tw12-pilot                    # 這次模擬的名稱（儲存桶裡的 runs/<SIM>）
FORK=base_the_ville_tw12          # 12 位居民的初始設定（原版 25 人：base_the_ville_n25）
DAYS=1                            # 跑到第幾個模擬天結束；試跑完改成 50 再用 update_env.sh
MAX_COST=150                      # 美元，到了就存檔停止
WORKERS=12
CHECKPOINT_EVERY=360              # 幾步存一次檔（360 步 = 1 個模擬小時）
FAKE_LLM=0                        # 1 = 不呼叫 API 的空跑（免費，用來確認部署正常）
OPENAI_SECRET=openai-api-key      # Secret Manager 裡金鑰的名稱

# ---- 模型（省錢版）----
GA_API=responses
GA_BASE_URL=
GA_MODEL=gpt-6-luna
GA_REASONING_HIGH=low             # 規劃、對話、反思
GA_REASONING_LOW=none             # 評分、選地點與物件、表情符號
GA_SERVICE_TIER=auto              # flex = 半價但較慢
GA_EMBED_MODEL=text-embedding-3-small
GA_EMBED_DIMENSIONS=512
GA_EMBED_EXTRA_BODY=
GA_LANGUAGE=zh-TW                 # 對話與想法用繁體中文；en = 全英文
GA_MAX_CONCURRENCY=16
GA_MAX_RPM=
GA_PRICE_INPUT=0.10
GA_PRICE_CACHED=0.01
GA_PRICE_OUTPUT=0.50
GA_PRICE_EMBED=0.02

# ---- 改用 NVIDIA NIM 測試時，把上面對應的幾行換成這些 ----
# OPENAI_SECRET=nim-api-key
# GA_API=chat
# GA_BASE_URL=https://integrate.api.nvidia.com/v1
# GA_MODEL=meta/llama-3.3-70b-instruct            # 到 build.nvidia.com 確認可用的模型名稱
# GA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# GA_EMBED_DIMENSIONS=
# GA_EMBED_EXTRA_BODY='{"input_type":"passage","truncate":"END"}'
# GA_MAX_RPM=35                                   # 免費帳號約每分鐘 40 次
# GA_MAX_CONCURRENCY=4
# GA_PRICE_INPUT=0
# GA_PRICE_CACHED=0
# GA_PRICE_OUTPUT=0
# GA_PRICE_EMBED=0
