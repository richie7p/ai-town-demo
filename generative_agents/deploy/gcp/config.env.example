# Copy to config.env and fill in. config.env is git-ignored. No secrets here:
# the OpenAI key goes into Secret Manager via setup.sh.
PROJECT_ID=your-project-id
REGION=asia-east1                 # Taiwan
ZONE=asia-east1-b
BUCKET=your-project-id-ga-runs    # created by setup.sh if it does not exist
REPO=generative-agents            # Artifact Registry repository
VM_NAME=ga-sim
MACHINE_TYPE=e2-standard-4        # 4 vCPU, 16 GB RAM
DISK_SIZE_GB=100

# Simulation
SIM=pilot-day1                    # run name (folder in the bucket: runs/<SIM>)
FORK=base_the_ville_n25           # base simulation for a new run
DAYS=1                            # run until the end of this simulated day
MAX_COST=60                       # USD; the run stops cleanly when reached
WORKERS=16
CHECKPOINT_EVERY=360              # steps (360 x 10 s = 1 simulated hour)
FAKE_LLM=0                        # 1 = dry run without API calls (free)

# Model (see reverie/backend_server/llm.py)
GA_MODEL=gpt-6-luna
GA_REASONING_HIGH=medium
GA_REASONING_LOW=low
GA_SERVICE_TIER=auto              # "flex" = half price, slower
GA_EMBED_MODEL=text-embedding-3-small
GA_EMBED_DIMENSIONS=512
